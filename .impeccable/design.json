      "css": ".ds-field{display:flex;flex-direction:column;gap:9px;margin-bottom:20px;font:600 .875rem 'Be Vietnam',system-ui,sans-serif;color:#23372f}.ds-field input{min-height:46px;border:1px solid #cbd8ce;border-radius:8px;background:var(--surface,#fff);color:#23372f;padding:11px 13px;width:100%;font:400 .9rem 'Be Vietnam',system-ui,sans-serif;caret-color:var(--green,#286a4c)}.ds-field input::placeholder{color:var(--muted,#607269);opacity:1}.ds-field input:focus{border-color:var(--green,#286a4c)}.ds-field input:focus-visible{outline:3px solid #548b58;outline-offset:4px}.ds-field small{font-size:.82rem;line-height:1.65;font-weight:400;color:var(--muted,#607269)}"
