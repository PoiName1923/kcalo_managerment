{
  "name": "calo-ingest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build-web.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "test:ui": "playwright test",
    "setup:telegram": "node --env-file=.env --import tsx scripts/setup.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.0.0",
    "@vercel/functions": "^3.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "fengari": "^0.1.5",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
