# Optional legacy shared bot. Leave these empty when using per-user bots in the web console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-or-publishable-key
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key backed up. Changing it without re-encrypting existing secrets breaks saved integrations.
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
CRON_SECRET=replace-with-at-least-32-random-characters
# Empty allows all private Telegram users. Comma-separated numeric user IDs restrict access.
ALLOWED_TELEGRAM_USER_IDS=
# Required origin for web login/CSRF protection and per-user webhook setup.
APP_URL=https://your-project.vercel.app
# Production login requires this proof from the Nginx gateway. Use the same value at both ends.
LOGIN_PROXY_SECRET=replace-with-at-least-32-random-url-safe-characters
